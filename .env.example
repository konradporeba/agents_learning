# Copy to .env to override. .env is gitignored.
# These values match the Compose and Settings defaults.

POSTGRES_USER=triage
POSTGRES_PASSWORD=triage
POSTGRES_DB=triage
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=triage

MONGO_USER=triage
MONGO_PASSWORD=triage
MONGO_DB=triage
MONGO_HOST=localhost
MONGO_PORT=27017

# OpenRouter. Put the key in .env only. The default model is a free NVIDIA chat model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
